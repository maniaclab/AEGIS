# OWL configuration. Copy to .env for local development.
#
#   cp .env.example .env
#
# In the cluster these come from the sealed secrets owl-db, owl-s3, owl-mattermost,
# openai-key and mcp-keys, plus the keycloak-config ConfigMap.

# ── process ──────────────────────────────────────────────────────────────────
OWL_MODE=mcp                 # mcp | worker
PORT=3400
LOG_LEVEL=info               # debug | info | warn | error

# ── database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yaml; in-cluster this points at owl-postgres:5432.
DATABASE_URL=postgres://owl:owl@localhost:5433/owl

# ── who may write ────────────────────────────────────────────────────────────
# Keycloak sub, preferred_username or email. Comma-separated. Anyone not listed
# can read, and anything they submit is quarantined.
OWL_TRUSTED_WRITERS=ivukotic

# Shared service keys. Read-only: they identify a service, not a person.
API_KEY_1=
API_KEY_2=

# ── identity ─────────────────────────────────────────────────────────────────
KEYCLOAK_URL=https://keycloak-prod.tempest.uchicago.edu
KEYCLOAK_REALM=AF-platform
KEYCLOAK_AUDIENCE=owl-mcp

# ── models ───────────────────────────────────────────────────────────────────
# Cheap, high-volume path: extraction, novelty, pairwise triage. Local vLLM.
OWL_CHEAP_BASE_URL=http://localhost:8000/v1
OWL_MODEL_CHEAP=nano-30b

# Rare path: adjudication of scope qualifications and true conflicts.
OWL_STRONG_BASE_URL=https://api.openai.com/v1
OWL_MODEL_STRONG=gpt-5

# Changing the dimension requires `npm run reembed`.
OWL_EMBEDDING_MODEL=text-embedding-3-large
OWL_EMBEDDING_DIMENSIONS=3072

OPENAI_API_KEY=

# ── originals ────────────────────────────────────────────────────────────────
# Set the S3 group in the cluster; BLOB_DIR is the local-dev fallback so running
# OWL on a laptop needs no credentials.
BLOB_DIR=./.blobs
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── notifications ────────────────────────────────────────────────────────────
# Unused until Phase 3 (dispute digests).
MATTERMOST_WEBHOOK_URL=
